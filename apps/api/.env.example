NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27017/examledger?replicaSet=rs0
# Generate a random secret of at least 32 characters. Never use this placeholder in production.
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_HOURS=12
LOG_LEVEL=info
# Trusted absolute application origin, never derived from a request Host header.
APP_URL=http://127.0.0.1:5174
# Development uses an authenticated local preview, never real delivery.
EMAIL_ADAPTER=preview
EMAIL_FROM=examledger@localhost.invalid
# Production requires an independent random 32-byte key encoded as 64 hexadecimal characters.
# Local previews derive their encryption key from CSRF_SECRET if this is left blank/omitted.
# EMAIL_ENCRYPTION_KEY=
# Production: EMAIL_ADAPTER=smtp, HTTPS APP_URL and all SMTP settings below.
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Optional initial admin; run npm run seed after configuring these.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Exam Administrator
