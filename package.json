{
  "name": "examledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w @examledger/api\" \"npm run dev -w @examledger/web\"",
    "build": "npm run build -w @examledger/web",
    "start": "npm run start -w @examledger/api",
    "seed": "npm run seed -w @examledger/api",
    "test": "npm run test -w @examledger/api",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "seed:dev": "node apps/api/src/seed-development.js",
    "seed:cse": "node apps/api/src/seed-cse.js",
    "migrate:questions": "node apps/api/src/migrate-questions.js",
    "migrate:question-metadata": "node apps/api/src/migrate-question-metadata.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local": "node scripts/local-database.js",
    "db:download": "node scripts/fetch-test-mongo.js",
    "setup:local": "node scripts/configure-local.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
